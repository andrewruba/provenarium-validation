{
  "name": "provenarium-validation",
  "version": "0.1.0",
  "description": "Local requirements, qualification protocols, and browser test evidence",
  "type": "module",
  "license": "MIT",
  "bin": {
    "provenarium": "bin/provenarium.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./example": "./dist/examples/sample-app/server.js",
    "./dilution-example": "./dist/examples/dilution-app/server.js"
  },
  "files": [
    "npm-shrinkwrap.json",
    "bin",
    "dist",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && tsc -p examples/tsconfig.json",
    "build:pages": "node scripts/build-pages.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests scripts 'examples/**/*.ts' 'examples/dilution-pages/**/*.js' '*.ts'",
    "format:check": "prettier --check src tests scripts 'examples/**/*.ts' 'examples/dilution-pages/**/*.js' '*.ts'",
    "verify:package": "node scripts/verify-package.mjs",
    "demo": "tsx examples/sample-app/server.ts",
    "demo:dilution": "tsx examples/dilution-app/server.ts",
    "demo:pages": "npm run build:pages && node scripts/serve-pages.mjs",
    "validate:dilution": "npm run build && node scripts/validate-dilution.mjs",
    "prepare:dilution": "node scripts/prepare-dilution.mjs",
    "validate:dilution:hosted": "npm run build && node scripts/validate-hosted-dilution.mjs",
    "prepare:dilution:pages": "node scripts/prepare-pages-dilution.mjs",
    "validate:dilution:pages": "npm run build && node scripts/validate-pages-dilution.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "@napi-rs/keyring": "2.1.2",
    "@playwright/test": "1.65.1",
    "cheerio": "1.2.0",
    "commander": "15.1.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.7",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewruba/provenarium-validation.git"
  },
  "homepage": "https://github.com/andrewruba/provenarium-validation#readme",
  "bugs": {
    "url": "https://github.com/andrewruba/provenarium-validation/issues"
  }
}
